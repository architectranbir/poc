# Foundry project endpoint, not a standalone Azure OpenAI endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL=YOUR-DEPLOYMENT-NAME
WEB_ORIGIN=http://localhost:5173
# Use Azure CLI identity locally. No API keys or secrets belong in source.

# Local single-process development recovery store (never commit real billing data).
# STATE_PATH=/absolute/path/to/local-state/billing.json

# Default is Entra. LocalDemo is allowed only in loopback Development mode.
AUTH_MODE=Entra
ENTRA_TENANT_ID=YOUR-TENANT-GUID
ENTRA_API_AUDIENCE=YOUR-API-APPLICATION-CLIENT-ID
# API registration must issue v2 access tokens with delegated Billing.Access scope.
